# Copy to .env for local dev. Never commit .env.
# Loaded automatically by tools/redshift.py at import time.

# Redshift credentials (required for query_redshift / load_redshift_to_frame tools)
export REDSHIFT_USER=
export REDSHIFT_PASSWORD=

# SSH bastion for cross-region Redshift access. Point to a .pem file readable
# by the current user. Alternatively set BASTION_KEY_CONTENT to raw PEM text.
export BASTION_KEY_PATH=~/.ssh/oceanhunter-prod-bastion-ec2.pem

# Optional overrides (defaults set in tools/redshift.py):
# export REDSHIFT_HOST=production-redshift-cluster.cwiqzcm13zcn.ap-southeast-1.redshift.amazonaws.com
# export REDSHIFT_PORT=5439
# export REDSHIFT_BASTION_IP=13.215.212.244

# Anthropic API key for the agent
export ANTHROPIC_API_KEY=
